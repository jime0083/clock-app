# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# RevenueCat Configuration
REVENUECAT_API_KEY=your_revenuecat_api_key

# X (Twitter) API Configuration
X_CLIENT_ID=your_x_client_id

# App Store審査用デモアカウント（Problem 50 / Guideline 2.1a）
# Firebaseで Email/Password プロバイダを有効化し作成したデモアカウントの認証情報
# 未設定の場合、ログイン画面の審査用デモ導線は無効になる
DEMO_ACCOUNT_EMAIL=your_demo_account_email
DEMO_ACCOUNT_PASSWORD=your_demo_account_password
